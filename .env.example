# ==============================================================================
# J.A.R.V.I.S. (Just A Rather Very Intelligent System) - Environment Template
# ==============================================================================
# Copy this file to '.env' and populate with your credentials.
# NEVER commit your actual '.env' file to public version control.

# --- Persona & Assistant Identity ---
ASSISTANT_NAME=JARVIS
USER_NAME=Sir

# --- Voice & Speech Synthesis ---
# en-GB-RyanNeural provides high-fidelity British butler cadence
TTS_VOICE=en-GB-RyanNeural
TTS_RATE=+0%
TTS_PITCH=+0Hz

# --- OmniRoute Gateway Integration ---
# OmniRoute acts as an intelligent multi-provider router & load balancer (OpenAI-compatible)
OMNIROUTE_PORT=20128
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=

# --- Cloud LLM Providers (Direct or via OmniRoute) ---
# Google Gemini API (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# OpenAI API Key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# --- Networking & Portal Ports ---
WEB_PORTAL_PORT=5050
